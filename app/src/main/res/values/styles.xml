<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ערכת נושא ראשית בגווני כחול כהה -->
    <style name="Theme.KeyLauncher" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- צבעים ראשיים -->
        <item name="colorPrimary">@color/dark_blue_primary</item>
        <item name="colorPrimaryDark">@color/dark_blue_dark</item>
        <item name="colorAccent">@color/dark_blue_accent</item>
        
        <!-- צבע רקע חלון -->
        <item name="android:windowBackground">@color/dark_blue_background</item>
    </style>

    <!-- הגדרת צבעים נלווים -->
    <color name="dark_blue_primary">#0D233A</color>
    <color name="dark_blue_dark">#071422</color>
    <color name="dark_blue_accent">#1E88E5</color>
    <color name="dark_blue_background">#0B192C</color>
</resources>
